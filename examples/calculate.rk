# Importing a function from another module and using it inside a
# try-guarded branch.
math inda add tago

kriya calculate(a: int, b: int):
    nodu:
        adre a > 10:
            kodu add(a, b)
        illa:
            kodu a
    tappu:
        kodu none

adre alla (calculate(12, 5) == 17):
    yese "imported function call inside try/if failed"
adre alla (calculate(8, 5) == 8):
    yese "else branch returning the untouched argument failed"

mudrisu("calculate: PASS")
