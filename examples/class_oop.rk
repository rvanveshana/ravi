# Comprehensive Object-Oriented Class Declaration Example in Ravi
# Kannada syntax: roopa (class), saarva (public), swanta (private)

roopa Person:
    saarva kriya huttu(name: string):
        tanna.name = name

    saarva kriya speak():
        mudrisu(tanna.name)

p = Person("Hello from Person class")
p.speak()
