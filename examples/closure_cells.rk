# Captured variables live in shared closure cells: mutating the captured
# name inside a nested function persists across separate calls to it.
kriya outer(value: int):
    kriya increment(dummy: int):
        value = value + 1
        kodu value
    kodu increment(0) + increment(0)

# First call returns 6 (5+1), second call returns 7 (6+1); sum is 13.
adre alla (outer(5) == 13):
    yese "closure cell mutation across calls failed"

mudrisu("closure_cells: PASS")
