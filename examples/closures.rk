# Ravi closures capture values from the surrounding scope.
factor = 3
scale = kriya(value: int) => value * factor
adre alla (scale(4) == 12):
    yese "single-variable closure capture failed"

# A closure can capture more than one enclosing binding at once.
multiplier = 10
adder = 5
compute = kriya(x: int) => (x * multiplier) + adder
adre alla (compute(2) == 25):
    yese "multi-variable closure capture failed"

mudrisu("closures: PASS")

