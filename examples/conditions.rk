# Comprehensive conditionals: if/elif/else, nesting, and logical operators.
x = 4
a = none

# Identity comparison distinguishes `ide` (is) from equality.
adre alla (a ide none):
    yese "none identity failed"

# if/elif/else picks exactly one branch.
result = 0
adre x > 5:
    result = 1
inadre x == 4:
    result = 2
illa:
    result = 3
adre alla (result == 2):
    yese "if/elif/else branch selection failed"

# Logical and/or combine boolean conditions.
adre alla (x > 2 mattu x < 10):
    yese "logical and failed"
adre alla (x == 4 athva x == 5):
    yese "logical or failed"

# `alla` negates a boolean value.
adre alla (alla (x == 99)):
    yese "logical not failed"

# Membership (`alli`) and identity (`ide`) as boolean expressions.
adre alla (4 alli [1, 4, 6]):
    yese "membership check failed"
adre alla (alla (7 alli [1, 4, 6])):
    yese "negative membership check failed"
adre alla (none ide none):
    yese "none identity as expression failed"

# Nested conditionals evaluate the innermost matching branch.
nested_result = 0
adre x >= 4:
    adre x <= 4:
        nested_result = 30
    illa:
        nested_result = 0
adre alla (nested_result == 30):
    yese "nested conditional failed"

mudrisu("conditions: PASS")
