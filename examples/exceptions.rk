# Exception callback conformance example.
# Each callback raises one public exception value. The inner handler catches
# that value; the outer handler catches unexpected failures in the test.
ravi.exceptions inda BaseException, Exception, RuntimeError, ArithmeticError, ZeroDivisionError, OverflowError, LookupError, IndexError, KeyError, NameError, UnboundLocalError, AttributeError, InvalidFunctionError, InvalidInstructionError, StackError, StackUnderflowError, StackOverflowError, CallStackOverflowError, InvalidLocalError, InvalidJumpError, CollectionError, CollectionFullError, StringTooLongError, MemoryError, OutOfMemoryError, DebuggerPausedError, RaisedExceptionError, ValueError, TypeError, ValidationError tago

# Exception constructors are first-class function values. Keep the imported
# constructors themselves in the callback list and invoke each one later.
exception_callbacks = [BaseException, Exception, RuntimeError, ArithmeticError, ZeroDivisionError, OverflowError, LookupError, IndexError, KeyError, NameError, UnboundLocalError, AttributeError, InvalidFunctionError, InvalidInstructionError, StackError, StackUnderflowError, StackOverflowError, CallStackOverflowError, InvalidLocalError, InvalidJumpError, CollectionError, CollectionFullError, StringTooLongError, MemoryError, OutOfMemoryError, DebuggerPausedError, RaisedExceptionError, ValueError, TypeError, ValidationError]

callback_count = 0
unexpected_exception = false
nodu:
    prati exception_callback alli exception_callbacks:
        nodu:
            yese exception_callback()
        tappu exception:
            callback_count = callback_count + 1
            bidu
tappu:
    unexpected_exception = true
    bidu

adre alla (callback_count == 30):
    yese "not every exception callback was handled"
adre unexpected_exception:
    yese "an exception escaped the callback handler"

# Custom exceptions use their own name and message instead of a built-in code.
custom_exception = {"name": "PaymentDeclined", "message": "card was declined"}
custom_message = ""
nodu:
    yese custom_exception
tappu exception:
    custom_message = exception["message"]
    bidu
adre alla (custom_message == "card was declined"):
    yese "custom exception message was not preserved"

# A real VM fault also enters the exception handler path.
division_caught = false
nodu:
    5 / 0
tappu exception:
    division_caught = true
    bidu
adre alla division_caught:
    yese "real division-by-zero exception was not caught"

mudrisu("exceptions: PASS")
