# Explicit exception flow: nodu (try), tappu (except), kone (finally).
# `kone` always runs, whether or not an exception was raised.
result = 0
finally_ran = alla true
nodu:
    yese 7
tappu:
    result = 9
kone:
    finally_ran = true
adre alla (result == 9):
    yese "except handler did not run"
adre alla finally_ran:
    yese "finally block did not run after except"

# A nested try/except: the inner handler catches its own exception, so the
# outer handler never fires, but the outer `kone` still runs.
inner_result = 0
outer_result = 0
outer_finally_ran = alla true
nodu:
    nodu:
        yese 42
    tappu:
        inner_result = 100
tappu:
    outer_result = 1
kone:
    outer_finally_ran = true
adre alla (inner_result == 100):
    yese "inner except handler failed"
adre alla (outer_result == 0):
    yese "outer except handler should not have run"
adre alla outer_finally_ran:
    yese "outer finally block did not run"

mudrisu("exceptions: PASS")
