# Default parameter values, positional overrides, and keyword arguments.
kriya greet(name: int, repeat: int = 2):
    kodu name * repeat

adre alla (greet(3) == 6):
    yese "default parameter value failed"
adre alla (greet(3, 4) == 12):
    yese "positional override of default failed"
adre alla (greet(name = 3, repeat = 5) == 15):
    yese "keyword arguments failed"

# Multiple defaults: only trailing parameters may be omitted.
kriya multi_defaults(a: int = 10, b: int = 20, c: int = 30):
    kodu a + b + c

adre alla (multi_defaults(1, 2, 3) == 6):
    yese "all arguments provided failed"
adre alla (multi_defaults(5, 5) == 40):
    yese "trailing default (c) failed"
adre alla (multi_defaults(100) == 150):
    yese "trailing defaults (b and c) failed"

mudrisu("function_defaults: PASS")

