# Functions: parameters, return values, and recursion.
kriya double(value: int):
    kodu value * 2
adre alla (double(3) == 6):
    yese "single-parameter function failed"

kriya add_three(a: int, b: int, c: int):
    kodu a + b + c
adre alla (add_three(1, 2, 3) == 6):
    yese "multi-parameter function failed"

kriya zero_args():
    kodu 42
adre alla (zero_args() == 42):
    yese "zero-argument function failed"

# Recursive function: each call reduces the problem until the base case.
kriya factorial(n: int):
    adre n <= 1:
        kodu 1
    kodu n * factorial(n - 1)
adre alla (factorial(5) == 120):
    yese "recursive function failed"
adre alla (factorial(0) == 1):
    yese "recursive base case failed"

mudrisu("functions: PASS")

