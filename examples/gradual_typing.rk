# Current annotation syntax accepts typed values alongside dynamic values.
# Union types, narrowing, conversions, and complete runtime guard contracts
# remain pending.

# Dynamic variable: no annotation, free to hold any value.
dynamic_val = 100
dynamic_val = dynamic_val + 50
adre alla (dynamic_val == 150):
    yese "dynamic variable arithmetic failed"

# Static integer annotation: still a normal runtime integer.
static_val: int = 500
static_val = static_val * 2
adre alla (static_val == 1000):
    yese "static integer annotation arithmetic failed"

# Static boolean and string annotations behave like their dynamic counterparts.
flag: bool = true
adre alla flag:
    yese "boolean annotation failed"

# Static homogeneous array annotation.
numbers: int[] = [10, 20, 30]
adre alla (numbers[0] == 10):
    yese "typed array indexing failed"
adre alla (numbers.gatra() == 3):
    yese "typed array length failed"

mudrisu("gradual_typing: PASS")
