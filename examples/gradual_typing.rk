# Current annotation syntax accepts typed values alongside dynamic values.
# Union types, narrowing, conversions, and complete runtime guard contracts
# remain pending.

# Dynamic variable (freedom)
dynamic_val = 100
dynamic_val = dynamic_val + 50
mudrisu(dynamic_val)

# Static integer annotation (speed path)
static_val: int = 500
static_val = static_val * 2
mudrisu(static_val)

# Static boolean & string annotations
flag: bool = true
adre flag:
    mudrisu(1)

# Static homogeneous array
numbers: int[] = [10, 20, 30]
mudrisu(numbers[0])
mudrisu(numbers.gatra())

