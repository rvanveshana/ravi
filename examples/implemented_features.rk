# Executable showcase of features verified in the current compiler and VM.

# String indexing, length, and slicing.
text = "Ravi"
adre alla (text[1] == 97):
    yese "string indexing failed"
adre alla (text.gatra() == 4):
    yese "string length failed"
text_window = text[1:3]
adre alla (text_window[0] == 97):
    yese "string slicing failed"
adre alla (text.huduk("av") >= 0):
    yese "string find failed"
adre alla (text.badla("Ravi", "Ravi language") == "Ravi language"):
    yese "string replace failed"

# Indexing and slicing.
values = [10, 20, 30, 40]
window = values[1:3]
adre alla (window[0] == 20):
    yese "list slicing failed"

# Dictionary views and indexable key/value items.
scores = {1: 90, 2: 80}
keys = scores.kili()
items = scores.jodi()
adre alla (keys.gatra() == 2):
    yese "dictionary keys view failed"
adre alla (items.gatra() == 2):
    yese "dictionary items view failed"

# Set operations.
left = {1, 2, 3}
right = {3, 4}
combined = left.koodu(right)
common = left.ondu(right)
only_left = left.bere(right)
adre alla (combined.gatra() == 4):
    yese "set union failed"
adre alla (common.gatra() == 1):
    yese "set intersection failed"
adre alla (only_left.gatra() == 2):
    yese "set difference failed"

# Typed and dynamic collections coexist.
typed_numbers: int[] = [100, 200, 300]
adre alla (typed_numbers[0] == 100):
    yese "typed array indexing failed"
adre alla (typed_numbers.gatra() == 3):
    yese "typed array length failed"

# Closure cells preserve mutation across calls.
kriya counter(value: int):
    kriya next(dummy: int):
        value = value + 1
        kodu value
    kodu next(0) + next(0)
adre alla (counter(4) == 11):
    yese "closure cell mutation across nested calls failed"

# Runtime exception recovery through tappu and kone.
result = 0
nodu:
    yese 7
tappu:
    result = 9
kone:
    result = result + 1
adre alla (result == 10):
    yese "except handler and finally accumulation failed"

mudrisu("implemented_features: PASS")

