# ravi.exceptions
# Public exception facade. Kannada/Kanglish names are the canonical
# implementations; English names are stable references to those operations.
# Exception names use PascalCase in both profiles, like MoolaDosha and
# BaseException. The returned value is a managed exception object shared by
# Ravi code and native runtime faults. Numeric identities are private
# diagnostic metadata. This file defines built-in references; application code
# defines custom classes with `roopa MyError guru Exception` and raises their
# instances through typed `tappu MyError aagi value` handlers.

kriya _exception(name):
    kodu __ravi_exception(name)

kriya MoolaDosha():
    kodu _exception("BaseException")
kriya BaseException():
    kodu MoolaDosha()

kriya Dosha():
    kodu _exception("Exception")
kriya Exception():
    kodu Dosha()

kriya ChalaneyaDosha():
    kodu _exception("RuntimeError")
kriya RuntimeError():
    kodu ChalaneyaDosha()

kriya GanitaDosha():
    kodu _exception("ArithmeticError")
kriya ArithmeticError():
    kodu GanitaDosha()

kriya ShunyaBhagaDosha():
    kodu _exception("ZeroDivisionError")
kriya ZeroDivisionError():
    kodu ShunyaBhagaDosha()

kriya ParimanaDosha():
    kodu _exception("OverflowError")
kriya OverflowError():
    kodu ParimanaDosha()

kriya HudukuDosha():
    kodu _exception("LookupError")
kriya LookupError():
    kodu HudukuDosha()

kriya SuchiDosha():
    kodu _exception("IndexError")
kriya IndexError():
    kodu SuchiDosha()

kriya KeyDosha():
    kodu _exception("KeyError")
kriya KeyError():
    kodu KeyDosha()

kriya HesaruDosha():
    kodu _exception("NameError")
kriya NameError():
    kodu HesaruDosha()

kriya BandhavilladaSathaliyaDosha():
    kodu _exception("UnboundLocalError")
kriya UnboundLocalError():
    kodu BandhavilladaSathaliyaDosha()

kriya GunaDosha():
    kodu _exception("AttributeError")
kriya AttributeError():
    kodu GunaDosha()

kriya AmanyaKriyaDosha():
    kodu _exception("InvalidFunctionError")
kriya InvalidFunctionError():
    kodu AmanyaKriyaDosha()

kriya AmanyaNirdeshaDosha():
    kodu _exception("InvalidInstructionError")
kriya InvalidInstructionError():
    kodu AmanyaNirdeshaDosha()

kriya StackDosha():
    kodu _exception("StackError")
kriya StackError():
    kodu StackDosha()

kriya StackKelaginaDosha():
    kodu _exception("StackUnderflowError")
kriya StackUnderflowError():
    kodu StackKelaginaDosha()

kriya StackMelinaDosha():
    kodu _exception("StackOverflowError")
kriya StackOverflowError():
    kodu StackMelinaDosha()

kriya KareyaStackMelinaDosha():
    kodu _exception("CallStackOverflowError")
kriya CallStackOverflowError():
    kodu KareyaStackMelinaDosha()

kriya AmanyaSthaliyaDosha():
    kodu _exception("InvalidLocalError")
kriya InvalidLocalError():
    kodu AmanyaSthaliyaDosha()

kriya AmanyaJumpsDosha():
    kodu _exception("InvalidJumpError")
kriya InvalidJumpError():
    kodu AmanyaJumpsDosha()

kriya SangrahaDosha():
    kodu _exception("CollectionError")
kriya CollectionError():
    kodu SangrahaDosha()

kriya SangrahaThumbidaDosha():
    kodu _exception("CollectionFullError")
kriya CollectionFullError():
    kodu SangrahaThumbidaDosha()

kriya StringHecchuDoddaDosha():
    kodu _exception("StringTooLongError")
kriya StringTooLongError():
    kodu StringHecchuDoddaDosha()

kriya MemoryDosha():
    kodu _exception("MemoryError")
kriya MemoryError():
    kodu MemoryDosha()

kriya MemorySakuIllaDosha():
    kodu _exception("OutOfMemoryError")
kriya OutOfMemoryError():
    kodu MemorySakuIllaDosha()

kriya DebugNillisidaDosha():
    kodu _exception("DebuggerPausedError")
kriya DebuggerPausedError():
    kodu DebugNillisidaDosha()

kriya YeseDosha():
    kodu _exception("RaisedExceptionError")
kriya RaisedExceptionError():
    kodu YeseDosha()

# Common application-facing names use the same public exception contract.
kriya MulyamanaDosha():
    kodu _exception("ValueError")
kriya ValueError():
    kodu MulyamanaDosha()

kriya PrakaraDosha():
    kodu _exception("TypeError")
kriya TypeError():
    kodu PrakaraDosha()

kriya ParikshaneDosha():
    kodu _exception("ValidationError")
kriya ValidationError():
    kodu ParikshaneDosha()

kriya CancelledError():
    kodu _exception("CancelledError")
kriya ChannelClosedError():
    kodu _exception("ChannelClosedError")
kriya ResourceLimitError():
    kodu _exception("ResourceLimitError")
kriya UnicodeError():
    kodu _exception("UnicodeError")
kriya JsonError():
    kodu _exception("JsonError")
kriya IoError():
    kodu _exception("IoError")
kriya AssertionError():
    kodu _exception("AssertionError")
kriya TimeoutError():
    kodu _exception("TimeoutError")
