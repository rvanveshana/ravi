# Annotated integer loop workload. The compiler must preserve integer values
# through the range and loop increment without converting them to collections.
kriya run(limit: int) -> none:
    prati i alli shreni(1, limit):
        prati j alli shreni(1, limit):
            prati k alli shreni(1, limit):
                munde

run(50)
mudrisu("typed-done")
